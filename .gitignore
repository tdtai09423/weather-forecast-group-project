# Large Data Files (never commit raw data)
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5
*.arrow
data_workspace/data/raw/*
data_workspace/data/processed/*
# Allow .gitkeep placeholders inside data dirs
!data_workspace/data/raw/.gitkeep
!data_workspace/data/processed/.gitkeep

# Model Artifacts (use DVC / cloud storage instead)
*.pkl
*.pickle
*.joblib
*.onnx
*.pt
*.pth
*.bin
data_workspace/models/*
!data_workspace/models/.gitkeep

